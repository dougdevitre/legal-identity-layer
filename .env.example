# Legal Identity Layer Configuration
# Copy this file to .env and fill in your values

# Application environment (development | staging | production)
NODE_ENV=development

# Server port
PORT=3000

# PostgreSQL connection string for identity and role data
DATABASE_URL=postgresql://localhost:5432/legal_identity

# JWT secret for signing access tokens (use a strong random value in production)
JWT_SECRET=your-jwt-secret

# JWT token expiry in seconds (default: 1 hour)
JWT_EXPIRY=3600

# OIDC provider configuration
OIDC_ISSUER=https://auth.justice-os.org
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Encryption key for sensitive credential data (256-bit hex-encoded key)
ENCRYPTION_KEY=your-256-bit-key
